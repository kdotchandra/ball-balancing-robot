# Python environment and caches
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Run logs: only the per-run data (CSV + JSON sidecar) and the small tilt/detection test CSVs are tracked.
# Debug frames, videos, presentation output, figures and the report stay on disk but out of git.
test_integrated_system/logs/*
!test_integrated_system/logs/run_*.csv
!test_integrated_system/logs/run_*.json
!test_integrated_system/logs/tilt_test_*.csv
!test_integrated_system/logs/detect_*.csv

# Early camera-test logs and unused flat-field calibration files
ping_pong_tracker/logs/
*.npz

# Videos, archives and generated reports (keep the small README GIF in docs/media/ only)
*.mp4
*.avi
*.mov
*.mkv
*.h264
*.zip
*.docx

# Presentation slides/videos and the written report: kept on disk only, not part of the project code
test_integrated_system/presentation_kit.py
test_integrated_system/presentation_assets.py
test_integrated_system/ch4_docx.py
test_integrated_system/ch4_figures.py
test_integrated_system/path_analysis.py
test_integrated_system/report_runs.json
test_integrated_system/assets/
